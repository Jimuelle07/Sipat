  "items": [
    { "id": "now-listen-radio", "text": "Makinig sa balita sa radyo o TV para sa pinakabagong update, babala at abiso tungkol sa panahon", "group": "now", "phase": ["before", "during"], "priority": 1, "critical": false, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "now-know-warning-evac-plan", "text": "Alamin ang plano ng komunidad sa pagbibigay-babala at paglikas", "group": "now", "phase": ["before"], "priority": 1, "critical": false, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "now-know-evac-route", "text": "Alamin ang lugar na paglilikasan at ang pinakamabilis at ligtas na daan papunta doon", "group": "now", "phase": ["before"], "priority": 1, "critical": false, "source_id": "qc-guide-landslide" },
    { "id": "now-charge-devices", "text": "Siguruhing fully charged ang cellphone at power bank", "group": "now", "phase": ["before"], "priority": 2, "critical": false, "source_id": "unicef-ph-typhoon" },
    { "id": "now-check-tcws-signal", "text": "Maging up-to-date sa typhoon signal warnings sa inyong lugar", "group": "now", "phase": ["before", "during"], "priority": 2, "critical": false, "source_id": "unicef-ph-typhoon" },
    { "id": "now-stay-indoors-calm", "text": "Manatiling mahinahon at manatili sa loob ng bahay o evacuation center", "group": "now", "phase": ["during"], "priority": 1, "critical": false, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "now-explain-to-children", "text": "Ipaliwanag sa mga bata kung paano mag-ingat at maghanda para hindi sila matakot sa bagyo", "group": "now", "phase": ["before", "during"], "requires_any": ["child"], "priority": 3, "critical": false, "source_id": "unicef-ph-typhoon" },
    { "id": "gobag-water", "text": "Inuming tubig", "group": "go_bag", "phase": ["before", "during"], "priority": 1, "critical": false, "source_id": "unicef-ph-go-bag" },
    { "id": "gobag-food", "text": "Pagkaing hindi madaling mapanis tulad ng de-lata at biskwit, kasama ang kubyertos", "group": "go_bag", "phase": ["before", "during"], "priority": 1, "critical": false, "source_id": "qc-guide-go-bag" },
    { "id": "gobag-flashlight-batteries", "text": "Flashlight, extra na baterya, power bank at charger", "group": "go_bag", "phase": ["before", "during"], "priority": 1, "critical": false, "source_id": "qc-guide-go-bag" },
    { "id": "gobag-whistle", "text": "Pito (whistle), isa para sa bawat miyembro ng pamilya pati mga bata", "group": "go_bag", "phase": ["before", "during"], "priority": 2, "critical": false, "source_id": "unicef-ph-go-bag" },
    { "id": "gobag-first-aid", "text": "First aid kit: band-aid, alcohol, gasa, medical tape at personal na gamot", "group": "go_bag", "phase": ["before", "during"], "priority": 1, "critical": false, "source_id": "qc-guide-go-bag" },
    { "id": "gobag-radio", "text": "Portable na radyo", "group": "go_bag", "phase": ["before", "during"], "priority": 2, "critical": false, "source_id": "unicef-ph-go-bag" },
    { "id": "gobag-documents-ids", "text": "ID at mahahalagang dokumento", "group": "go_bag", "phase": ["before", "during"], "priority": 2, "critical": false, "source_id": "qc-guide-go-bag" },
    { "id": "gobag-cash", "text": "Emergency na pera, ATM card o passbook", "group": "go_bag", "phase": ["before", "during"], "priority": 2, "critical": false, "source_id": "unicef-ph-go-bag" },
    { "id": "gobag-clothes-hygiene", "text": "Extra na damit, kumot, tsinelas, jacket, sabon, toothbrush at toothpaste", "group": "go_bag", "phase": ["before", "during"], "priority": 3, "critical": false, "source_id": "qc-guide-go-bag" },
    { "id": "gobag-emergency-numbers", "text": "Listahan ng emergency numbers, pati contact numbers ng barangay o LGU", "group": "go_bag", "phase": ["before", "during"], "priority": 2, "critical": false, "source_id": "unicef-ph-go-bag" },
    { "id": "gobag-infant-supplies", "text": "Diaper, wet wipes, vitamins at gamot ng sanggol", "group": "go_bag", "phase": ["before", "during"], "requires_any": ["infant"], "priority": 1, "critical": false, "source_id": "unicef-ph-go-bag" },
    { "id": "gobag-maintenance-meds", "text": "Personal at maintenance na gamot; i-check ang expiration date at palitan kung kailangan", "group": "go_bag", "phase": ["before", "during"], "requires_any": ["maintenance_meds", "senior"], "priority": 1, "critical": false, "source_id": "qc-guide-go-bag" },
    { "id": "gobag-child-comfort", "text": "Laruan o comfort object para sa mga bata", "group": "go_bag", "phase": ["before", "during"], "requires_any": ["child"], "priority": 3, "critical": false, "source_id": "unicef-ph-go-bag" },
    { "id": "gobag-pet-supplies", "text": "Ihanda ang paglipat ng alagang hayop sa ligtas na lugar o sa itinakdang evacuation site para sa hayop", "group": "go_bag", "phase": ["before", "during"], "requires_any": ["pets"], "priority": 3, "critical": false, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "home-repair-weak-parts", "text": "Suriin ang bahay at kumpunihin ang mga mahina o sirang bahagi nito", "group": "home", "phase": ["before"], "priority": 2, "critical": false, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "home-secure-light-roof", "text": "Itali ang bubong at iba pang maaaring liparin ng hangin", "group": "home", "phase": ["before"], "when": { "tcws_min": 2 }, "requires_any": ["light_materials"], "priority": 1, "critical": false, "source_id": "unicef-ph-typhoon" },
    { "id": "home-move-upper-floor", "text": "Iakyat sa mas mataas na lugar o palapag ang mahahalagang kagamitan", "group": "home", "phase": ["before", "during"], "when": { "rainfall_min": "orange" }, "requires_any": ["upper_floor"], "priority": 2, "critical": false, "source_id": "qc-guide-flood" },
    { "id": "home-switch-off-main", "text": "Patayin ang main switch ng kuryente at valve ng tubig kung kinakailangan", "group": "home", "phase": ["during"], "priority": 1, "critical": true, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "home-flashlight-not-candle", "text": "Gumamit ng flashlight o emergency lamp; maging maingat sa paggamit ng kandila o gasera", "group": "home", "phase": ["during"], "priority": 1, "critical": true, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "home-away-from-windows", "text": "Umiwas sa mga salamin at bintana", "group": "home", "phase": ["during"], "priority": 1, "critical": false, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "home-no-touch-electric-wet", "text": "Huwag hawakan ang mga de-kuryenteng kagamitan kung basa ka o nakalubog sa baha", "group": "home", "phase": ["during"], "priority": 1, "critical": true, "source_id": "qc-guide-flood" },
    { "id": "evacuate-when-advised", "text": "Kapag inabisuhan ng barangay o lokal na pamahalaan, mabilis na lumikas sa itinakdang evacuation center", "group": "evacuate", "phase": ["before", "during"], "priority": 1, "critical": true, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "evacuate-near-river", "text": "Malapit sa ilog o nasa mababang lugar: sundin ang alituntunin sa paglikas, at huwag lumangoy o mamangka sa umaapaw na ilog", "group": "evacuate", "phase": ["before", "during"], "when": { "tcws_min": 3, "rainfall_min": "orange" }, "requires_any": ["near_river", "low_lying"], "priority": 1, "critical": true, "source_id": "qc-guide-flood" },
    { "id": "evacuate-near-sea-surge", "text": "Malapit sa dagat at may babala ng storm surge: lumikas sa mataas at ligtas na lugar kapag inabisuhan ng MDRRMC o barangay", "group": "evacuate", "phase": ["before", "during"], "when": { "surge_min": "yellow" }, "requires_any": ["near_sea"], "priority": 1, "critical": true, "source_id": "pagasa-storm-surge" },
    { "id": "evacuate-slope-landslide", "text": "Nasa dalisdis: kapag inabisuhan ng kinauukulan, mabilis na lumikas sa ligtas na lugar dahil sa panganib ng pagguho ng lupa", "group": "evacuate", "phase": ["before", "during"], "when": { "rainfall_min": "orange" }, "requires_any": ["slope"], "priority": 1, "critical": true, "source_id": "qc-guide-landslide" },
    { "id": "evacuate-switch-off-before-leaving", "text": "Bago lumikas, patayin ang switch ng kuryente, tubig at tangke ng LPG", "group": "evacuate", "phase": ["before", "during"], "priority": 1, "critical": true, "source_id": "qc-guide-flood" },
    { "id": "evacuate-avoid-floodwater", "text": "Huwag maglakad o magmaneho sa lugar na baha", "group": "evacuate", "phase": ["during", "after"], "priority": 1, "critical": true, "source_id": "qc-guide-flood" },
    { "id": "after-wait-safe-return", "text": "Hintayin ang abiso ng kinauukulan na ligtas na bago bumalik sa bahay", "group": "after", "phase": ["after"], "priority": 1, "critical": true, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "after-avoid-power-lines", "text": "Umiwas sa mga natumbang puno, nasirang gusali at linya ng kuryente", "group": "after", "phase": ["after"], "priority": 1, "critical": true, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "after-check-wet-outlets", "text": "Huwag buksan ang main switch o gumamit ng appliances hangga't hindi nasusuri ng electrician", "group": "after", "phase": ["after"], "priority": 1, "critical": true, "source_id": "qc-guide-flood" },
    { "id": "after-boil-water", "text": "Siguraduhing hindi kontaminado ng baha ang inuming tubig at pagkain", "group": "after", "phase": ["after"], "priority": 1, "critical": false, "source_id": "qc-guide-flood" },
    { "id": "after-throw-stagnant-water", "text": "Itapon ang naipong tubig sa lata, paso at gulong para hindi pamahayan ng lamok", "group": "after", "phase": ["after"], "priority": 3, "critical": false, "source_id": "qc-guide-tropical-cyclone" },
    { "id": "after-check-children", "text": "Kumustahin ang mga bata at pakinggan ang kanilang iniisip at nararamdaman pagkatapos ng bagyo", "group": "after", "phase": ["after"], "requires_any": ["child"], "priority": 3, "critical": false, "source_id": "unicef-ph-typhoon" }
  ]
}
