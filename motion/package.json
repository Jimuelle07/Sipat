{
  "name": "sipat-motion",
  "private": true,
  "description": "Sipat product film (Remotion). Separate from the Expo app; reads brand assets from ../assets.",
  "scripts": {
    "prepare-assets": "python scripts/prepare_assets.py",
    "score": "python scripts/score.py",
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "remotion render SipatShowreel30 out/showreel-30/sipat-showreel-30.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --concurrency=4",
    "render:vertical": "remotion render SipatShowreel30Vertical out/showreel-30/sipat-showreel-30-vertical.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --concurrency=4"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
